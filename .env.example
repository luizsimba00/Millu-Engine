# Neon: banco operacional e tokens OAuth cifrados.
DATABASE_URL=""

# Chave para entrar no painel e autorizar a criação manual de pedidos.
POC_API_KEY=""

# OAuth do único aplicativo Olist configurado.
OLIST_CLIENT_ID=""
OLIST_CLIENT_SECRET=""
OLIST_REDIRECT_URI="https://SEU-DOMINIO.vercel.app/api/olist/callback"

# Chave base64url de 32 bytes para cifrar tokens antes de salvá-los no Neon.
TOKEN_ENCRYPTION_KEY=""

# Segurança: mantenha true até testar o fluxo completo; depois altere para false.
OLIST_SIMULATE=true
