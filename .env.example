# Ambiente
NODE_ENV=development
PORT=3000

# Banco Neon PostgreSQL. Nunca versione a URL real.
DATABASE_URL=

# Chave para a rota manual da POC. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POC_API_KEY=

# Assinatura HMAC para futuro webhook Tray. Gere um segredo diferente para cada ambiente.
WEBHOOK_SECRET=

# Protege a limpeza diária programada.
CRON_SECRET=

# Retenção de registros da POC. Não armazene PII no banco.
RETENTION_DAYS=30

# Regras de roteamento por SKU
MILLU_ROUTE_A_PREFIX=MIL-A
MILLU_ROUTE_B_PREFIX=MIL-B
MILLU_COMPANY_A_NAME="Empresa A"
MILLU_COMPANY_B_NAME="Empresa B"

# Olist: mantenha true até a homologação.
OLIST_SIMULATE=true
OLIST_API_BASE_URL=https://api.tiny.com.br/public-api/v3
OLIST_API_TIMEOUT_MS=15000
OLIST_COMPANY_A_WAREHOUSE_ID=0
OLIST_COMPANY_A_CUSTOMER_ID=0
OLIST_COMPANY_A_ECOMMERCE_ID=0
OLIST_COMPANY_A_ACCESS_TOKEN=
OLIST_COMPANY_B_WAREHOUSE_ID=0
OLIST_COMPANY_B_CUSTOMER_ID=0
OLIST_COMPANY_B_ECOMMERCE_ID=0
OLIST_COMPANY_B_ACCESS_TOKEN=
